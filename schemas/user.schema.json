{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User (users collection)",
  "type": "object",
  "required": ["_id", "name", "email", "addresses"],
  "properties": {
    "_id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email" },
    "addresses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "line1", "city", "country"],
        "properties": {
          "label": { "type": "string" },
          "line1": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
